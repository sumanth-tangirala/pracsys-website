<header id="masthead" class="site-header" role="banner">
  <div class="header-inner">
    <div class="site-branding">
      <a href="/" class="custom-logo-link" rel="home">
        <img class="custom-logo" src="{{ site.logo }}" width="800" height="157" fetchpriority="high" alt="Rutgers | PRACSYS Lab — Prof. Kostas Bekris">
      </a>
    </div>
    <button type="button" id="nav-toggle" aria-controls="site-navigation" aria-expanded="false"><span class="nav-toggle-label">Menu</span><span class="nav-toggle-icon" aria-hidden="true"></span></button>
    <nav id="site-navigation" class="main-navigation" aria-label="Primary">
      <ul class="onepress-menu">
        {%- for item in site.nav %}
        <li><a href="{{ item.href }}"{% if page.url == item.href or (item.href != '/' and item.href.indexOf('#') == -1 and page.url.indexOf(item.href) == 0) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
