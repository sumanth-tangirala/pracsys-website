{
  "name": "pracsys-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static replica of the PRACSYS Lab website (Rutgers) with a browser-based publications editor.",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve --port=8080",
    "build": "eleventy",
    "build:pages": "PATH_PREFIX=/pracsys-website/ eleventy",
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate-publications.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8"
  }
}
