@article{Hodan:2018aa,
title = {A Summary of the 4th International Workshop on Recovering 6d Object Pose},
author = {T Hodan and R Kouskouridas and T Kim and F Tombari and K Bekris and B Drost and T Groueix and K Walas and V Lepetit and A Leonardis and C Steger and F Michel and C Sahin and C Rother and J Matas},
